<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_credit_limit_warning" model="ir.ui.view">
        <field name="name">sale.order.form.credit.limit.warning</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Hide core's single yellow banner; the field stays in the arch so that
                 `partner_credit_warning` remains readable through the form. -->
            <xpath expr="//field[@name='partner_credit_warning']/parent::div" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_credit_warning']/parent::div" position="after">
                <div class="alert alert-warning" role="alert"
                     invisible="credit_warning_level != 'warning'">
                    <field name="credit_warning_message"/>
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="credit_warning_level != 'danger'">
                    <field name="credit_warning_message"/>
                </div>
                <field name="credit_warning_level" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
